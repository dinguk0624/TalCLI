{
  "name": "talcli",
  "version": "0.1.0",
  "description": "Your all-in-one chill companion for the terminal — focus sprints, breathing breaks, motivation, and handy dev tools.",
  "type": "module",
  "license": "MIT",
  "author": "dinguk0624",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinguk0624/TalCLI.git"
  },
  "homepage": "https://github.com/dinguk0624/TalCLI#readme",
  "bugs": {
    "url": "https://github.com/dinguk0624/TalCLI/issues"
  },
  "bin": {
    "tal": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "productivity",
    "focus",
    "pomodoro",
    "breathe",
    "wellness",
    "developer-tools",
    "terminal",
    "chill"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "npm run build && node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
